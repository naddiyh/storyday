# Required by the Flutter app. Find these in your Daystick Supabase project.
SUPABASE_URL=https://YOUR_PROJECT_REF.supabase.co
SUPABASE_PUBLISHABLE_KEY=
# Legacy projects may use the anon key instead (choose one client key).
SUPABASE_ANON_KEY=

# Optional: deployment metadata / local CLI access only.
# These values are NEVER forwarded to the Flutter build by tool/flutter-env.ps1.
SUPABASE_PROJECT_REF=
SUPABASE_ACCESS_TOKEN=
SUPABASE_DB_PASSWORD=

# No service-role / sb_secret key is needed for this app. Do not add one.
